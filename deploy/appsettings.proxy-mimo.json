{
  "_readme": "Example dedicated MiMo proxy. Copy beside the published appsettings.json, then set the backend URL and model for your server. This file contains no credentials.",

  "RoutingOptions": {
    "ListenUrl": "http://0.0.0.0:8020",
    "PrimaryBackend": {
      "BaseUrl": "http://127.0.0.1:8100",
      "RewriteModel": "mimo-2.6-flash",
      "ModelAlias": "mimo-2.6-flash"
    }
  },

  "StructuredOutputOptions": {
    "DisableThinkingForResponseFormat": true
  },

  "MultimodalOptions": {
    "Enabled": false
  },

  "LoopGuardOptions": {
    "Enabled": false
  }
}
