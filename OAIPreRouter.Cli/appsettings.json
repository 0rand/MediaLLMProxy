{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "RoutingOptions": {
    "ListenUrl": "http://0.0.0.0:7071",
    "PrimaryBackend": {
      "BaseUrl": "http://localhost:8000"
    },
    "FastBackend": {
      "BaseUrl": "http://localhost:8000",
      "MaxConcurrentConnections": 2
    },
    "HeavyBackend": {
      "BaseUrl": "http://localhost:8000",
      "MaxConcurrentConnections": 2
    },
    "SystemPromptThresholdBytes": 100000,
    "FastLaneThresholdBytes": 65536,
    "LogDecisions": true,
    "LogBodies": false,
    "VerboseRequests": false
  },
  "MultimodalOptions": {
    "Enabled": false,
    "VisionBackend": {
      "BaseUrl": "http://localhost:8000"
    },
    "VisionModel": "Qwen3.6-35B-A3B-MLX-VL-oQ8",
    "VideoModel": "mlx-community--gemma-4-12B-it-OptiQ-4bit",
    "FrameIntervalSec": 1,
    "MaxFrames": 10,
    "AudioBackend": {
      "BaseUrl": "http://127.0.0.1:8085"
    },
    "SttModel": "stt-large-v3",
    "SttPrompt": "prompt-v1",
    "MaxObservationTokens": 512,
    "TimeoutSeconds": 90,
    "CacheTtlHours": 24,
    "CacheCapacity": 512,
    "UrlPolicy": {
      "AllowDataUrls": true,
      "AllowHttpsHosts": [],
      "MaxMediaBytes": 5000000
    }
  }
}
